VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Key de OpenRouter para la estimación de comida. Vive SOLO en el servidor
# (función /api de Vercel). No se embebe en el bundle del frontend.
# En local con `vercel dev`, ponela en `.env`. En Vercel, configurala como
# variable de entorno del proyecto (nunca arrancar con VITE_ si no querés
# exponerla en el bundle).
OPENROUTER_API_KEY=

# Key de respaldo de Groq (opcional). Si OpenRouter falla o agota el cupo
# diario de modelos gratis, la app salta a Groq para no quedarse sin respuesta.
GROQ_API_KEY=